# Copy this file to `.env` in the same folder as `manage.py`, then edit values.
# Never commit `.env` (it is listed in `.gitignore`).

# Required for production (DJANGO_DEBUG=0): long random string, 50+ characters.
# DJANGO_SECRET_KEY=

# 1 = development (default), 0 = production-style checks
DJANGO_DEBUG=1

# Comma-separated hostnames the site may be served on
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set to 1 only when the site is served over HTTPS (enables Secure cookies)
DJANGO_HTTPS=0

# When using HTTPS behind a domain, set your full origin(s), e.g.:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://school.example.com

# --- PostgreSQL (optional; default is SQLite) ---
# Set to 1 to use PostgreSQL instead of db.sqlite3 (requires pip install "psycopg[binary]")
# DJANGO_USE_POSTGRES=0
# POSTGRES_DB=school_db
# POSTGRES_USER=school_db
# POSTGRES_PASSWORD=secret
# (omit POSTGRES_PASSWORD for empty password / local trust auth)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Optional: persistent connections in seconds (default 60 when DEBUG=0, else 0)
# POSTGRES_CONN_MAX_AGE=60
# Optional for cloud DBs: require, verify-full, etc.
# POSTGRES_SSLMODE=require

# --- Backups (management command) ---
# Optional output directory for: python manage.py backup_database
# BACKUP_DIR=C:\backups\school_db
# SQLite: copies db.sqlite3 into that folder.
# PostgreSQL: runs pg_dump (PostgreSQL client tools must be on PATH).
